# Salin file ini menjadi .env di SERVER (jangan di-commit).
# Isi bagian bertanda <...> dengan nilai asli.

APP_NAME="Inventaris Stok"
APP_ENV=production
APP_KEY=                      # isi dengan: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://ifs24011-pabwe2026-sk-p7-laravel-livewire.s1if.cloud

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Aplikasi berjalan di belakang nginx dengan HTTPS
FORCE_HTTPS=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database_server>
DB_USERNAME=<user_database>
DB_PASSWORD=<password_database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<domain_kamu>"
MAIL_FROM_NAME="${APP_NAME}"

# Fitur "Generate Stok dengan AI" (opsional).
# Endpoint lokal Ollama (127.0.0.1) TIDAK tersedia di server, jadi fitur AI hanya
# berfungsi jika diarahkan ke endpoint yang bisa dijangkau dari server.
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_KEY=<api_key_opsional>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120
